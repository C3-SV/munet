SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PORT=3002
WEB_APP_URL=http://localhost:3000


# Estado usado para soft-delete de mensajes directos.
# Debe existir en dm_message_status_enum.

# Almacenamiento de adjuntos (API compatible con S3; hoy Cloudflare R2). Solo servidor, nunca al navegador.
# Endpoint de R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com. Region "auto" por defecto.
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Desactiva el rate limiting (solo pruebas locales o de carga). En produccion debe quedar vacio o en false.
RATE_LIMIT_DISABLED=
